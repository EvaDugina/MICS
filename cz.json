{
  "commitizen": {
    "name": "cz_conventional_commits",
    "tag_format": "$version",
    "version_scheme": "semver",
    "version": "0.2.1",
    "update_changelog_on_bump": true,
    "major_version_zero": true,
    "customize": {
      "bump_pattern": "^(new|feat|fix)",
      "bump_map": {
        "new": "MAJOR",
        "feat": "MINOR",
        "fix": "PATCH"
      }
    }
  }
}